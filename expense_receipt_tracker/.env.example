# Copy to .env and adjust if you want standalone dev to talk to Postgres
# (docker-compose.yml) instead of the default local SQLite file.
# DATABASE_URL=postgresql+psycopg://palette_user:palette_user_password@localhost:5456/expense_receipt_tracker

# Where uploaded receipt files are stored on disk in standalone/dev mode.
# STORAGE_DIR=backend/data/receipts

# Optional. Without it, receipt/invoice/statement field extraction is regex
# heuristics only (still works fine for most single-column receipts). With
# it, the LLM gets a chance to read messier documents (multi-line invoices,
# varied statement layouts) — but every value it returns is checked against
# the source document's text before it's trusted; see backend/api/core/extraction.py.
# OPENAI_KEY=sk-...
