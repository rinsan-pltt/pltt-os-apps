{
  "manifest_version": "1",
  "id": "expense-receipt-tracker",
  "name": "Expense & Receipt Tracker",
  "version": "0.0.0025",
  "developer": "Your Team",
  "category": "Finance",
  "data_scope": "organization",
  "tagline": "Scan receipts, categorize expenses, and export reimbursement reports",
  "description": "Snap or upload a receipt and the plugin reads the vendor, date and total automatically. Review, categorize and track every expense, then export a clean CSV or PDF reimbursement report for finance. Receipts and expense records are stored for the life of the plugin so nothing has to be re-entered.",
  "icon": "Receipt",
  "gradient": {
    "bg": "linear-gradient(135deg, #059669, #0D9488)",
    "text": "#fff"
  },
  "sdk": {
    "frontend": "^0.1.16",
    "backend": "^0.1.0"
  },
  "platform": {
    "min_version": "0.1.0"
  },
  "capabilities": {
    "frontend": true,
    "backend": true,
    "database": true,
    "webhooks": false,
    "scheduled_jobs": false,
    "file_uploads": true,
    "external_network": [
      "api.openai.com"
    ]
  },
  "database": {
    "schema": "app_expense_receipt_tracker",
    "migrations": "./backend/migrations"
  },
  "platform_services": [
    "storage"
  ],
  "public_routes": [],
  "scheduled_jobs": [],
  "rate_limit": {
    "per_minute": 120
  },
  "frontend": {
    "entry": "./frontend/app",
    "sandbox": true,
    "framework": "palette-app"
  },
  "backend": {
    "entry": "./backend/api/main.py"
  },
  "agents": [],
  "tools": [],
  "connections": [],
  "permissions": [
    "tasks:read",
    "resources:read",
    "resources:write"
  ],
  "secrets": {
    "OPENAI_KEY": {
      "scope": "plugin",
      "required": false
    }
  }
}
