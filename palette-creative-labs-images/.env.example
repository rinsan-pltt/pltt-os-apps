# Template for the local .env — every variable it needs, with the
# values left blank. Copy to .env and fill them in.
#
# Generated from the working .env, so the variable set matches exactly.
# Real values never belong in this file: it is committed.

# ─── AI Providers ─────────────────────────────────────────────────────────────
# FAL_KEY=a34726f2-b8c7-4528-a127-0f12095532a4:c9e1ab67916babe26d2cd0f0a2d40b98
RUNWARE_KEY=
MIDJOURNEY_KEY=
MIDJOURNEY_TT_API_KEY_FALLBACK=
OPENAI_KEY=
GOOGLE_AI_API_KEY=

# ─── Databases ─────────────────
# NOTE: do not set a plain `DATABASE_URL` here. `pltt dev --sandbox`/publish
# auto-uploads every undeclared uppercase key from this file as a staging
# plugin secret, so a local DB URL would leak. The dev runner reads
# PALETTE_DEV_DATABASE_URL (PALETTE_* keys are reserved and never uploaded),
# and hosted/staging uses the platform-injected PALETTE_DB_URL.
# DATABASE_URL=postgresql+asyncpg://palette_user:palette_user_password@localhost:5454/
PALETTE_DEV_DATABASE_URL=

PREVIEW_MODE=

LLM_ROUTER_API_KEY=
LLM_ROUTER_ENABLED=
LLM_ROUTER_BASE_URL=
