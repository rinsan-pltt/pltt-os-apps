{
  "manifest_version": "1",
  "id": "pltt-storyboard-video-maker",
  "name": "Storyboard & Video",
  "version": "0.0.0755",
  "developer": "Palette Creative Labs",
  "category": "Creative",
  "tagline": "Turn any story into video, scene by scene",
  "description": "Plan a brief into a storyboard, generate each scene's image and motion, then merge them into one finished video — Brief → Storyboard → Animate → Publish.",
  "icon": "Sparkles",
  "gradient": {
    "bg": "linear-gradient(135deg, #6366F1, #8B5CF6)",
    "text": "#fff"
  },
  "sdk": {
    "frontend": "^0.1.16",
    "backend": "^0.1.13"
  },
  "platform": {
    "min_version": "0.1.0"
  },
  "capabilities": {
    "frontend": true,
    "backend": true,
    "database": true,
    "webhooks": false,
    "scheduled_jobs": false,
    "file_uploads": true,
    "external_network": [
      "fal.run",
      "queue.fal.run",
      "api.runware.ai",
      "api.ttapi.io",
      "api.openai.com",
      "generativelanguage.googleapis.com",
      "graph.facebook.com",
      "open.tiktokapis.com"
    ]
  },
  "database": {
    "schema": "app_pltt_storyboard_video_maker",
    "migrations": "./backend/migrations"
  },
  "data_scope": "organization",
  "platform_services": ["storage"],
  "public_routes": [],
  "scheduled_jobs": [],
  "rate_limit": {
    "per_minute": 120
  },
  "frontend": {
    "entry": "./frontend/app",
    "sandbox": true,
    "framework": "palette-app"
  },
  "backend": {
    "entry": "./backend/api/main.py"
  },
  "agents": [],
  "tools": [],
  "connections": [],
  "permissions": [
    "tasks:read",
    "resources:read",
    "resources:write",
    "chat:write"
  ],
  "secrets": {
    "FAL_KEY": { "scope": "plugin", "required": true },
    "RUNWARE_KEY": { "scope": "plugin", "required": true },
    "MIDJOURNEY_KEY": { "scope": "plugin", "required": false },
    "MIDJOURNEY_TT_API_KEY_FALLBACK": { "scope": "plugin", "required": false },
    "OPENAI_KEY": { "scope": "plugin", "required": false },
    "GOOGLE_AI_API_KEY": { "scope": "plugin", "required": false },
    "ANTHROPIC_API_KEY": { "scope": "plugin", "required": false },
    "ELEVEN_API_KEY": { "scope": "plugin", "required": false },
    "YOU_TUBE_API_KEY": { "scope": "plugin", "required": false },
    "GOOGLE_CLIENT_ID": { "scope": "plugin", "required": false },
    "GOOGLE_CLIENT_SECRET": { "scope": "plugin", "required": false },
    "META_APP_ID": { "scope": "plugin", "required": false },
    "META_APP_SECRET": { "scope": "plugin", "required": false },
    "TIKTOK_CLIENT_KEY": { "scope": "plugin", "required": false },
    "TIKTOK_CLIENT_SECRET": { "scope": "plugin", "required": false },
    "OAUTH_TOKEN_ENCRYPTION_KEY": { "scope": "plugin", "required": false },
    "LANGSMITH_API_KEY": { "scope": "plugin", "required": false },
    "LANGSMITH_PROJECT": { "scope": "plugin", "required": false },
    "LLM_ROUTER_ENABLED": { "scope": "plugin", "required": false },
    "LLM_ROUTER_API_KEY": { "scope": "plugin", "required": false },
    "LLM_ROUTER_BASE_URL": { "scope": "plugin", "required": false }
  }
}
