# Template for the local .env — every variable it needs, with the
# values left blank. Copy to .env and fill them in.
#
# Generated from the working .env, so the variable set matches exactly.
# Real values never belong in this file: it is committed.

# ─── AI Providers ─────────────────────────────────────────────────────────────
FAL_KEY=
RUNWARE_KEY=
MIDJOURNEY_KEY=
MIDJOURNEY_TT_API_KEY_FALLBACK=
OPENAI_KEY=
GOOGLE_AI_API_KEY=

# ─── Databases ─────────────────
# NOTE: do not set a plain `DATABASE_URL` here. `pltt dev --sandbox`/publish
# auto-uploads every undeclared uppercase key from this file as a staging
# plugin secret, so a local DB URL would leak. The dev runner reads
# PALETTE_DEV_DATABASE_URL (PALETTE_* keys are reserved and never uploaded),
# and hosted/staging uses the platform-injected PALETTE_DB_URL.
# DATABASE_URL=postgresql+asyncpg://palette_user:palette_user_password@localhost:5454/
PALETTE_DEV_DATABASE_URL=

# ─── Local GCS credentials (pltt dev only) ─────────────────
# App code never talks to GCS directly — it always goes through the Palette
# SDK (`ctx.storage` / `ctx.data_rooms`), which the OS backs with GCS in
# hosted environments. `credentials.json` (gitignored, never bundled by
# `pltt package`/publish) is only for ad-hoc local testing against the real
# bucket. If you ever need to point local tooling at it, use a PALETTE_-
# prefixed var (e.g. PALETTE_DEV_GOOGLE_APPLICATION_CREDENTIALS) — anything
# else uppercase and undeclared gets auto-uploaded as a staging plugin secret
# by `pltt dev --sandbox`/publish.
# PALETTE_DEV_GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

PREVIEW_MODE=

LLM_ROUTER_API_KEY=
LLM_ROUTER_ENABLED=
LLM_ROUTER_BASE_URL=
