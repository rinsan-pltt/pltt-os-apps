# Template for the local .env — every variable it needs, with the
# values left blank. Copy to .env and fill them in.
#
# Generated from the working .env, so the variable set matches exactly.
# Real values never belong in this file: it is committed.

# Palette local developer secrets.
# This file is for pltt dev only and must not be committed.

LLM_ROUTER_BASE_URL=
# TODO: paste your local router key (either this or NUXT_PUBLIC_GATEWAY_KEY).
LLM_ROUTER_API_KEY=

# Alias used by palette-router-gateway.
NUXT_PUBLIC_GATEWAY_KEY=

LLM_ROUTER_FAST_MODEL=
LLM_ROUTER_TEXT_MODEL=
GEMINI_FLASH_LITE_MODEL=
# Blank = use backend/api/sample_data/employee_hierarchy.sample.json
EMPLOYEE_HIERARCHY_SAMPLE_PATH=
