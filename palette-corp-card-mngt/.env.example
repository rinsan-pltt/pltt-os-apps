POSTGRES_IMAGE=postgres:18
REDIS_IMAGE=redis:8

POSTGRES_HOST=postgres
POSTGRES_PORT=55437
POSTGRES_DB=palette_org_explorer_app
POSTGRES_USER=palette_org_explorer_app
POSTGRES_PASSWORD=palette_org_explorer_password

# Docker containers use the Compose service name; local commands use localhost.
LOCAL_DATABASE_URL=postgresql+asyncpg://palette_org_explorer_app:palette_org_explorer_password@127.0.0.1:55437/palette_org_explorer_app
DOCKER_DATABASE_URL=postgresql+asyncpg://palette_org_explorer_app:palette_org_explorer_password@postgres:5432/palette_org_explorer_app

REDIS_HOST=redis
REDIS_PORT=56379

API_PORT=4663
WEB_PORT=4664
DOCKER_NETWORK=palette-org-explorer-app-network

# Palette CLI local simulator / Docker platform-dev ports.
PLTT_ENV=staging
PLTT_FRONTEND_PORT=57230
PLTT_BACKEND_PORT=57330
PLTT_DEV_DATABASE_URL=postgresql+asyncpg://palette_org_explorer_app:palette_org_explorer_password@127.0.0.1:55437/palette_org_explorer_app
PLTT_PLATFORM_IMAGE=ghcr.io/palette-lab/platform-dev:latest

# Latest @palettelab/cli environment names for direct pltt commands.
PALETTE_FRONTEND_PORT=57230
PALETTE_BACKEND_PORT=57330
PALETTE_DEV_DATABASE_URL=postgresql+asyncpg://palette_org_explorer_app:palette_org_explorer_password@127.0.0.1:55437/palette_org_explorer_app
PALETTE_DEV_IMAGE=ghcr.io/palette-lab/platform-dev:latest

DATABASE_URL=postgresql+asyncpg://palette_org_explorer_app:palette_org_explorer_password@postgres:5432/palette_org_explorer_app
STANDALONE_ORGANIZATION_ID=1
STANDALONE_USER_ID=dev-user
STANDALONE_ORG_ROLE=owner

# --- Policy knowledge base (absorbed from palette-policy-hub) ---
POLICY_RAG_MODE=auto
POLICY_TOP_K=10
POLICY_ANSWER_MODEL=claude-sonnet-4-6
POLICY_ANSWER_CACHE_TTL=300
# Optional: enables Claude-synthesized grounded answers; without it policy.ask uses an
# extractive fallback. Set the real value in .env only — never commit it.
ANTHROPIC_API_KEY=

# Vector embeddings are done by the PLATFORM, not this plugin: the platform reads
# OPENAI_API_KEY from ITS env and embeds with text-embedding-3-small. Required for
# semantic/hybrid policy search — without it retrieval silently drops to lexical-only
# (the plugin logs `vector_degraded_runtime`). docker-compose.platform-apps.yml passes
# this through to the platform container. Set the real value in .env only — never commit.
OPENAI_API_KEY=
# Optional platform-RAG overrides (compose/Makefile defaults shown):
PLTT_PLATFORM_RAG_ENABLED=true
PLTT_PLATFORM_POLICY_RAG_MODE=auto
PLTT_PLATFORM_QDRANT_COLLECTION=org_documents

# --- MCP server for EXTERNAL LLM clients (self-hosted, separate process) ---
# DB the MCP process queries (host/local form). Mirrors LOCAL_DATABASE_URL.
POLICY_DB_URL=postgresql+asyncpg://palette_org_explorer_app:palette_org_explorer_password@127.0.0.1:55437/palette_org_explorer_app
# JSON map {"<token>": <organization_id>} authorizing external MCP clients.
# One token per org; rotate regularly; never commit real values.
MCP_ORG_TOKENS=
POLICY_DEFAULT_ORG_ID=1
MCP_TRANSPORT=stdio

# Talk channel for corporate-card notices (channel id or name). Optional: with
# no value the app posts to the first channel its agent was invited to.
CORPORATE_CARD_TALK_CHANNEL=
