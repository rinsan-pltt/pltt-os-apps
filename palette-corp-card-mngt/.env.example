# Template for the local .env — every variable it needs, with the
# values left blank. Copy to .env and fill them in.
#
# Generated from the working .env, so the variable set matches exactly.
# Real values never belong in this file: it is committed.

POSTGRES_IMAGE=
REDIS_IMAGE=

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Docker containers use the Compose service name; local commands use localhost.
LOCAL_DATABASE_URL=
DOCKER_DATABASE_URL=

REDIS_HOST=
REDIS_PORT=

API_PORT=
WEB_PORT=
DOCKER_NETWORK=

# Palette CLI local simulator / Docker platform-dev ports.
PLTT_ENV=
PLTT_FRONTEND_PORT=
PLTT_BACKEND_PORT=
PLTT_DEV_DATABASE_URL=
PLTT_PLATFORM_IMAGE=

# Latest @palettelab/cli environment names for direct pltt commands.
PALETTE_FRONTEND_PORT=
PALETTE_BACKEND_PORT=
PALETTE_DEV_DATABASE_URL=
PALETTE_DEV_IMAGE=

DATABASE_URL=
STANDALONE_ORGANIZATION_ID=
# NOTE: left unset deliberately. The literal `dev-user` is a public identifier —
# it is the default test persona (frontend/src/index.tsx:650) and a member_id in
# backend/api/sample_data/employee_hierarchy.sample.json. Setting it here makes
# `pltt test`'s leak scanner substring-match it inside the frontend bundle and fail.
# Nothing in this repo, the CLI, or the SDK reads STANDALONE_USER_ID.
# STANDALONE_USER_ID=dev-user
STANDALONE_ORG_ROLE=

# --- Policy knowledge base (absorbed from palette-policy-hub) ---
POLICY_RAG_MODE=
POLICY_TOP_K=
POLICY_ANSWER_MODEL=
POLICY_ANSWER_CACHE_TTL=
# TODO: paste your Anthropic key. Without it policy.ask uses an extractive fallback.
ANTHROPIC_API_KEY=

# TODO: paste your OpenAI key. Read by the PLATFORM for embeddings; without it
# policy retrieval silently drops to lexical-only (`vector_degraded_runtime`).
OPENAI_KEY=

GOOGLE_AI_API_KEY=
# Optional platform-RAG overrides (compose/Makefile defaults shown):
PLTT_PLATFORM_RAG_ENABLED=
PLTT_PLATFORM_POLICY_RAG_MODE=
PLTT_PLATFORM_QDRANT_COLLECTION=

# --- MCP server for EXTERNAL LLM clients (self-hosted, separate process) ---
# DB the MCP process queries (host/local form). Mirrors LOCAL_DATABASE_URL.
POLICY_DB_URL=
# TODO: JSON map {"<token>": <organization_id>} authorizing external MCP clients.
MCP_ORG_TOKENS=
POLICY_DEFAULT_ORG_ID=
MCP_TRANSPORT=
