{
  "manifest_version": "1",
  "id": "newsletter",
  "name": "Newsletter Studio",
  "version": "1.0.139",
  "developer": "Your Team",
  "category": "Productivity",
  "data_scope": "organization",
  "tagline": "AI-assisted, document-grounded newsletter studio",
  "description": "Generate branded newsletters from uploaded documents via RAG, with AI image generation, mascot art, and PDF/HTML export.",
  "icon": "Newspaper",
  "gradient": {
    "bg": "linear-gradient(135deg, #8B5CF6, #EC4899)",
    "text": "#fff"
  },
  "sdk": {
    "frontend": "^0.1.16",
    "backend": "^0.1.13"
  },
  "platform": {
    "min_version": "0.1.0"
  },
  "capabilities": {
    "frontend": true,
    "backend": true,
    "database": true,
    "webhooks": false,
    "scheduled_jobs": false,
    "file_uploads": true
  },
  "platform_services": ["storage", "vector"],
  "secrets": {
    "LLM_ROUTER_BASE_URL": {
      "scope": "dev",
      "required": false,
      "label": "LLM Router base URL"
    },
    "LLM_ROUTER_API_KEY": {
      "scope": ["dev", "plugin"],
      "required": false,
      "label": "LLM Router API key"
    },
    "NUXT_PUBLIC_GATEWAY_KEY": {
      "scope": ["dev", "plugin"],
      "required": false,
      "label": "LLM Router gateway key alias"
    },
    "LLM_ROUTER_TEXT_MODEL": {
      "scope": "dev",
      "required": false,
      "label": "Text model"
    },
    "LLM_ROUTER_IMAGE_MODEL": {
      "scope": "dev",
      "required": false,
      "label": "Image generation model"
    },
    "LLM_ROUTER_IMAGE_QUALITY_MODEL": {
      "scope": "dev",
      "required": false,
      "label": "Image model (structural/pose tier)"
    },
    "GCS_BUCKET_NAME": {
      "scope": "dev",
      "required": false,
      "label": "Standalone-mode GCS bucket",
      "help": "Only used by the local-credentials storage fallback (storage.py) when ctx.storage is unavailable, e.g. the plugin's standalone Docker runtime. pltt dev / hosted sandbox / production use ctx.storage instead."
    },
    "GCS_CREDENTIALS_PATH": {
      "scope": "dev",
      "required": false,
      "label": "Standalone-mode GCS service-account credentials path"
    }
  },
  "database": {
    "schema": "app_newsletter",
    "migrations": "./backend/migrations"
  },
  "frontend": {
    "entry": "./frontend/src/index.tsx",
    "sandbox": true
  },
  "backend": {
    "entry": "./backend/api/main.py"
  },
  "permissions": [
    "resources:read",
    "resources:write",
    "chat:write"
  ]
}
