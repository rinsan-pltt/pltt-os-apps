# Template for the local .env — every variable it needs, with the
# values left blank. Copy to .env and fill them in.
#
# Generated from the working .env, so the variable set matches exactly.
# Real values never belong in this file: it is committed.

POSTGRES_IMAGE=

POSTGRES_HOST=
POSTGRES_PORT=
# Values deliberately don't equal the bare string "newsletter" (the plugin
# slug) — pltt dev --sandbox's preflight flags any .env value that appears
# verbatim in the built frontend bundle as a leaked secret, and "newsletter"
# is baked into the bundle everywhere as the app name, causing a false
# positive on POSTGRES_DB/POSTGRES_USER.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Docker containers use the Compose service name; host processes use localhost.
LOCAL_DATABASE_URL=
DOCKER_DATABASE_URL=

DOCKER_NETWORK=

# --- LLM gateway (see backend/api/llm_router.py) ---
# Used by newsletter generation (chat_json) and mascot/image gen (generate_image
# / edit_image / remove_background). Without these, /newsletters/generate and
# related routes 503 with "LLM router is not configured."
LLM_ROUTER_ENABLED=
LLM_ROUTER_BASE_URL=
LLM_ROUTER_API_KEY=

# Points `pltt dev`'s local SDK simulator (.palette/dev/backend_runner.py) at
# real dockerized Postgres instead of its default SQLite fallback file.
PALETTE_DEV_DATABASE_URL=
PLTT_DEV_DATABASE_URL=

# --- Standalone-mode-only direct GCS fallback (see backend/api/storage.py) ---
# Only consulted when ctx.storage is unavailable, which pltt dev's local
# simulator effectively is (it only ever returns file:// URLs). Absolute path
# used instead of the "../credentials.json" example because pltt dev runs the
# backend from .palette/dev, not the repo root, so a relative path resolved
# to the wrong directory.
GCS_BUCKET_NAME=
GCS_CREDENTIALS_PATH=
APP_MEDIA_GCS_ENABLED=
