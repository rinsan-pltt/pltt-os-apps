POSTGRES_IMAGE=postgres:18

POSTGRES_HOST=postgres
POSTGRES_PORT=55447
POSTGRES_DB=newsletter
POSTGRES_USER=newsletter
POSTGRES_PASSWORD=newsletter_password

# Docker containers use the Compose service name; host processes use localhost.
LOCAL_DATABASE_URL=postgresql+asyncpg://newsletter:newsletter_password@127.0.0.1:55447/newsletter
DOCKER_DATABASE_URL=postgresql+asyncpg://newsletter:newsletter_password@postgres:5432/newsletter

DOCKER_NETWORK=newsletter-network

# Points `pltt dev`'s local SDK simulator (.palette/dev/backend_runner.py) at
# real dockerized Postgres instead of its default SQLite fallback file.
PALETTE_DEV_DATABASE_URL=postgresql+asyncpg://newsletter:newsletter_password@127.0.0.1:55447/newsletter
PLTT_DEV_DATABASE_URL=postgresql+asyncpg://newsletter:newsletter_password@127.0.0.1:55447/newsletter

# --- Standalone-mode-only direct GCS fallback (see backend/api/storage.py) ---
# Only consulted when ctx.storage is unavailable. Leave unset for pltt dev / hosted sandbox.
GCS_BUCKET_NAME=palette_external_uploads
GCS_CREDENTIALS_PATH=../credentials.json
APP_MEDIA_GCS_ENABLED=true